# Optional local configuration. No paid APIs or secrets are required.
LASTRADA_DATA_DIR=data/private
LASTRADA_CACHE_DIR=cache
LASTRADA_SAMPLEID_CHECKPOINT=

# Optional stem-assisted validation after Sony + guarded DTW.
# Install with scripts/install_stems.ps1 before enabling.
# The default of 50 covers every Sony candidate returned by the adapter.
# This can be very slow on CPU and can generate many exploratory matches.
LASTRADA_STEM_ENABLED=0
LASTRADA_STEM_MODEL=htdemucs_6s
LASTRADA_STEM_DEVICE=cpu
LASTRADA_STEM_MAX_CANDIDATES=50
LASTRADA_STEM_PADDING_SECONDS=4.0
LASTRADA_STEM_CROSS_OTHER=1
